{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "embedding": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:/.-]*$"
        }
      }
    },
    "dream": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "lint",
              "backlinks",
              "sync",
              "synthesize",
              "extract",
              "patterns",
              "embed",
              "orphans"
            ]
          }
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
