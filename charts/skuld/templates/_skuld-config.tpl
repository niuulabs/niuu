{{- /*
The broker's config.yaml, rendered from a set of values: the release's own, or a member's of a
unit (see skuld.memberValues). Every line is indented four spaces, to sit under a ConfigMap key.
*/ -}}
{{- define "skuld.configYaml" -}}
{{- if .Values.wsAuth.enforce_ownership }}
{{- if not (or (and .Values.envoy.enabled .Values.envoy.jwt.enabled) (and .Values.gateway.enabled .Values.gateway.jwt.enabled)) }}
{{- fail "WebSocket ownership enforcement requires a JWT-verifying Envoy sidecar or Gateway" }}
{{- end }}
{{- if not (and .Values.session.ownerId .Values.session.tenantId) }}
{{- fail "WebSocket ownership enforcement requires session ownerId and tenantId" }}
{{- end }}
{{- if eq .Values.wsAuth.room_role_source "remote" }}
{{- fail "wsAuth.room_role_source: remote requires wsAuth.enforce_ownership: false — the pod-local ext_authz sidecar gates every connection to Cedar's owner/admin-only 'start' action before a remote room-role lookup ever runs, so a participant could never attach" }}
{{- end }}
{{- end }}
    # Skuld broker configuration (generated by Helm)
    {{- /*
    room_role_remote is rendered explicitly (never a blind toYaml passthrough)
    so it appears ONLY when room_role_source is "remote" — existing clusters
    must render byte-identical wsAuth otherwise — and so volundr_api_url is
    always populated from .Values.volundr.apiUrl (the same value the broker's
    own top-level volundr_api_url and workload_identity.exchange_url use)
    without requiring an operator or RoomRoleSourceContributor to repeat it.
    An explicit wsAuth.room_role_remote.kwargs.volundr_api_url override still
    wins over that default.
    */}}
    {{- $wsAuth := omit .Values.wsAuth "room_role_remote" }}

    ws_auth:
      user_id_header: {{ .Values.envoy.headerNames.userId | quote }}
      tenant_header: {{ .Values.envoy.headerNames.tenant | quote }}
      roles_header: {{ .Values.envoy.headerNames.roles | quote }}
      display_name_header: {{ .Values.envoy.headerNames.displayName | quote }}
      role_mapping: {{ .Values.envoy.authorization.roleMapping | toJson }}
      {{- toYaml $wsAuth | nindent 6 }}
      {{- if eq .Values.wsAuth.room_role_source "remote" }}
      room_role_remote:
        adapter: {{ dig "room_role_remote" "adapter" "skuld.room_role_remote.RemoteAuthorizationAdapter" .Values.wsAuth | quote }}
        kwargs:
          volundr_api_url: {{ (dig "room_role_remote" "kwargs" "volundr_api_url" .Values.volundr.apiUrl .Values.wsAuth) | quote }}
          token_file: {{ (dig "room_role_remote" "kwargs" "token_file" "/var/run/secrets/niuu-workload/token" .Values.wsAuth) | quote }}
          {{- range $k, $v := dig "room_role_remote" "kwargs" dict .Values.wsAuth }}
          {{- if not (has $k (list "volundr_api_url" "token_file")) }}
          {{ $k }}: {{ $v | toJson }}
          {{- end }}
          {{- end }}
        secret_kwargs_env: {{ dig "room_role_remote" "secret_kwargs_env" dict .Values.wsAuth | toJson }}
      {{- end }}
      {{- if .Values.identityAuthority.enabled }}
      identity:
        adapter: identity.adapters.remote.RemoteHeaderAuthenticationAdapter
        kwargs:
          {{- include "skuld.identityAuthorityKwargs" . | nindent 10 }}
      {{- end }}

    session:
      id: {{ include "skuld.sessionId" . | quote }}
      name: {{ .Values.session.name | quote }}
      model: {{ .Values.session.model | quote }}
      {{- if .Values.session.reasoningEffort }}
      reasoning_effort: {{ .Values.session.reasoningEffort | quote }}
      {{- end }}
      {{- if .Values.session.ownerId }}
      owner_id: {{ .Values.session.ownerId | quote }}
      {{- end }}
      {{- if .Values.session.tenantId }}
      tenant_id: {{ .Values.session.tenantId | quote }}
      {{- end }}
      {{- if .Values.session.systemPrompt }}
      system_prompt: {{ .Values.session.systemPrompt | quote }}
      {{- end }}
      {{- if .Values.session.persona }}
      persona: {{ .Values.session.persona | toJson }}
      {{- end }}
      {{- if .Values.session.initialPrompt }}
      initial_prompt: {{ .Values.session.initialPrompt | quote }}
      {{- end }}

    mcp_servers: {{ .Values.mcpServers | default list | toJson }}
    transport: {{ .Values.broker.transport | default "sdk" | quote }}
    transport_adapter: {{ .Values.broker.transportAdapter | default "skuld.transports.sdk.SDKTransport" | quote }}
    cli_binary: {{ .Values.broker.cliBinary | default "claude" | quote }}
    muse_bin: {{ .Values.broker.museBin | default "" | quote }}
    tmux_question_transcript_max_bytes: {{ .Values.broker.tmuxQuestionTranscriptMaxBytes | default 1048576 }}
    tmux_question_result_history_limit: {{ .Values.broker.tmuxQuestionResultHistoryLimit | default 128 }}
    tmux_native_text_wait_s: {{ .Values.broker.tmuxNativeTextWaitSeconds | default 0.1 }}
    tmux_native_text_poll_s: {{ .Values.broker.tmuxNativeTextPollSeconds | default 0.005 }}
    remote_control_permission_mode: {{ .Values.broker.remoteControlPermissionMode | default "" | quote }}
    skip_permissions: {{ .Values.broker.skipPermissions }}
    agent_teams: {{ .Values.broker.agentTeams | default false }}
    cli_type: {{ .Values.broker.cliType | default "claude" | quote }}
    history_read_timeout_seconds: {{ .Values.broker.historyReadTimeoutSeconds | default 2.0 }}
    history_bootstrap_max_frames: {{ .Values.broker.historyBootstrapMaxFrames | default 256 }}
    conversation_recent_max_turns: {{ .Values.broker.conversationRecentMaxTurns | toJson }}
    conversation_recent_max_bytes: {{ .Values.broker.conversationRecentMaxBytes | toJson }}
    conversation_snapshot_max_bytes: {{ .Values.broker.conversationSnapshotMaxBytes | toJson }}
    live_frame_max_bytes: {{ .Values.broker.liveFrameMaxBytes | toJson }}
    codex_receive_max_bytes: {{ .Values.broker.codexReceiveMaxBytes | toJson }}
    event_log_enabled: {{ .Values.broker.eventLogEnabled | toJson }}
    activity_reporting_enabled: {{ .Values.broker.activityReportingEnabled | toJson }}
    history_hydration_enabled: {{ .Values.broker.historyHydrationEnabled | toJson }}
    history_hydration_timeout_seconds: {{ .Values.broker.historyHydrationTimeoutSeconds | toJson }}
    history_hydration_page_size: {{ .Values.broker.historyHydrationPageSize | toJson }}
    history_hydration_max_frames: {{ .Values.broker.historyHydrationMaxFrames | toJson }}
    history_hydration_max_bytes: {{ .Values.broker.historyHydrationMaxBytes | toJson }}
    effort_control_timeout_s: {{ .Values.broker.effortControlTimeoutSeconds | toJson }}
    pi: {{ .Values.broker.pi | toJson }}
    codex_auth:
      adapter: {{ dig "codexAuth" "adapter" "skuld.codex_auth.HostCodexAuthProvider" .Values.broker | quote }}
      kwargs: {{ dig "codexAuth" "kwargs" dict .Values.broker | toJson }}
    host: {{ ternary "127.0.0.1" "0.0.0.0" (and .Values.wsAuth.enforce_ownership .Values.envoy.enabled) | quote }}
    port: {{ .Values.brokerPort | default 8081 }}
    workflow_steps:
      enabled: {{ .Values.workflowSteps.enabled | toJson }}
      root: {{ .Values.workflowSteps.root | toJson }}
      run_id: {{ .Values.workflowSteps.runId | toJson }}
      member: {{ .Values.workflowSteps.member | toJson }}
      persona_alias: {{ .Values.workflowSteps.personaAlias | toJson }}
      orchestrator_peer_id: {{ .Values.workflowSteps.orchestratorPeerId | toJson }}
      event_filters: {{ .Values.workflowSteps.eventFilters | toJson }}
      topics: {{ .Values.workflowSteps.topics | default list | toJson }}
      {{- with .Values.workflowSteps.orchestration }}
      orchestration: {{ . | toJson }}
      {{- end }}
    persistence_mount_path: {{ .Values.persistence.mountPath | default "/volundr/sessions" | quote }}
    {{- if .Values.homeVolume.enabled }}
    persistent_home_path: {{ .Values.homeVolume.mountPath | quote }}
    {{- end }}
    max_presented_file_bytes: {{ .Values.broker.maxPresentedFileBytes | default 52428800 }}

    {{- if .Values.volundr.apiUrl }}
    volundr_api_url: {{ .Values.volundr.apiUrl | quote }}
    {{- end }}
    service_user_id: {{ .Values.volundr.serviceUserId | default "skuld-broker" | quote }}
    service_tenant_id: {{ .Values.volundr.serviceTenantId | default "default" | quote }}
    {{- if .Values.preview.enabled }}
    {{- $workload := .Values.envoy.jwt.workload }}
    {{- if not (and $workload.issuer $workload.jwksUri) }}
    {{- fail "preview.enabled needs envoy.jwt.workload.issuer and envoy.jwt.workload.jwksUri: the router credential is a workload JWT Skuld verifies against them" }}
    {{- end }}

    # Live preview: this pod is the session, so every listener in its network
    # namespace is offered except the pod's own infrastructure.
    preview:
      enabled: true
      port_scan_interval_seconds: {{ .Values.preview.portScanIntervalSeconds }}
      port_scanner:
        adapter: skuld.preview_adapters.ProcNetListeningPortScanner
        kwargs:
          excluded_ports: {{ include "skuld.previewExcludedPorts" . }}
      router_auth:
        adapter: skuld.preview_adapters.WorkloadJwtRouterAuth
        kwargs:
          issuer: {{ $workload.issuer | quote }}
          audience: {{ .Values.preview.routerAudience | quote }}
          jwks_uri: {{ $workload.jwksUri | quote }}
    {{- end }}
    {{- if or .Values.forgeMcp.tokenFile (not (kindIs "invalid" .Values.forgeMcp.brokerRequestTimeoutS)) (not (kindIs "invalid" .Values.forgeMcp.toolTimeoutS)) }}

    # The session-bound Forge credential, mounted by Forge from a per-session Secret
    # (forge_mcp.session_tokens.projection_adapter). Only the file path is a value.
    forge_mcp:
      {{- if .Values.forgeMcp.tokenFile }}
      token_file: {{ .Values.forgeMcp.tokenFile | quote }}
      {{- end }}
      {{- if kindIs "slice" .Values.forgeMcp.grants }}
      grants: {{ .Values.forgeMcp.grants | toJson }}
      {{- end }}
      {{- if not (kindIs "invalid" .Values.forgeMcp.brokerRequestTimeoutS) }}
      broker_request_timeout_s: {{ .Values.forgeMcp.brokerRequestTimeoutS | toJson }}
      {{- end }}
      {{- if not (kindIs "invalid" .Values.forgeMcp.toolTimeoutS) }}
      tool_timeout_s: {{ .Values.forgeMcp.toolTimeoutS | toJson }}
      {{- end }}
    {{- end }}

    # How request_secret waits for the user's answer in the chat card.
    secret_requests:
      poll_interval_s: {{ .Values.secretRequests.pollIntervalS | toJson }}
      wait_max_s: {{ .Values.secretRequests.waitMaxS | toJson }}

    # How ask waits for another session's answer.
    ask:
      poll_interval_s: {{ .Values.ask.pollIntervalS | toJson }}
      wait_max_s: {{ .Values.ask.waitMaxS | toJson }}

    {{- include "skuld.meshConfig" . | nindent 4 }}
    {{- if .Values.room.enabled }}

    # The room this session hosts: its mesh realm's members as workers.
    room:
      enabled: true
      environment_id: {{ .Values.room.environmentId | default .Values.mesh.realmId | quote }}
      realm_room: {{ .Values.room.realmRoom | toJson }}
      routed: {{ .Values.room.routed | toJson }}
    {{- end }}
{{- end }}
