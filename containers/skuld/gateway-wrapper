#!/usr/bin/env python3
"""Route a CLI through the Niuu model gateway with renewable workload auth.

Both Claude Code and Codex need to reach Bifrost with a bearer token, and
neither can refresh one itself: Claude reads ANTHROPIC_AUTH_TOKEN once, and
Codex's ModelProviderInfo offers only `env_key` / `experimental_bearer_token`,
read from the environment when its long-lived app-server spawns. Workload
identity JWTs last 900s, so a token handed to either CLI goes stale.

So the stable thing handed to a CLI is a URL, not a token: this wrapper serves
a loopback listener and mints a fresh JWT per request, upstream over HTTPS.

Activated purely by configuration — no model is named here. It engages when
SKULD__MODEL_GATEWAY__URL points at a loopback address (which also makes skuld's
Codex transport skip the ChatGPT login) and NIUU_GATEWAY_UPSTREAM names the
Bifrost base URL. Anything else execs the real CLI untouched.
"""

import ipaddress
import os
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

import httpx

from niuu.adapters.outbound.http_auth import WorkloadIdentityBearerTokenAuthAdapter

LISTEN_ENV = "SKULD__MODEL_GATEWAY__URL"
UPSTREAM_ENV = "NIUU_GATEWAY_UPSTREAM"
AUDIENCE_ENV = "NIUU_GATEWAY_AUDIENCE"

# Hop-by-hop headers, plus the ones we re-derive. `authorization`/`x-api-key`
# are dropped so a CLI's own vendor credential is never forwarded upstream.
DROP = {
    "host",
    "authorization",
    "x-api-key",
    "connection",
    "transfer-encoding",
    "content-length",
    "accept-encoding",
    "content-encoding",
}


def _loopback_listen(url):
    """Return (host, port) if `url` is a loopback listener we should serve."""
    if not url:
        return None
    parts = urlsplit(url)
    if not parts.hostname or not parts.port:
        return None
    try:
        if not ipaddress.ip_address(parts.hostname).is_loopback:
            return None
    except ValueError:
        return None
    return parts.hostname, parts.port


def _session_model():
    try:
        from skuld.config import SkuldSettings

        return SkuldSettings().session.model or ""
    except Exception:
        return ""


def main():
    args = sys.argv[1:]
    tool = os.path.basename(sys.argv[0])
    native = "/usr/local/bin/" + tool

    listen = _loopback_listen(os.environ.get(LISTEN_ENV, ""))
    upstream = os.environ.get(UPSTREAM_ENV, "").rstrip("/")
    if not listen or not upstream:
        os.execv(native, [native, *args])

    audiences = [a for a in os.environ.get(AUDIENCE_ENV, "volundr-api").split(",") if a]
    auth = WorkloadIdentityBearerTokenAuthAdapter(audiences=audiences)
    lock = threading.Lock()
    client = httpx.Client(timeout=600)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_POST(self):
            self.forward()

        def do_GET(self):
            self.forward()

        def forward(self):
            if not self.path.startswith("/v1/"):
                self.send_error(404)
                return
            body = self.rfile.read(int(self.headers.get("Content-Length", "0")))
            headers = {k: v for k, v in self.headers.items() if k.lower() not in DROP}
            with lock:
                headers.update(auth.headers())
            try:
                with client.stream(
                    self.command, upstream + self.path, headers=headers, content=body
                ) as response:
                    self.send_response(response.status_code)
                    for key, value in response.headers.items():
                        if key.lower() not in DROP:
                            self.send_header(key, value)
                    self.send_header("Connection", "close")
                    self.end_headers()
                    for chunk in response.iter_bytes():
                        self.wfile.write(chunk)
                        self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                self.close_connection = True

    try:
        server = ThreadingHTTPServer(listen, Handler)
    except OSError:
        # Another wrapper in this pod already serves the listener (the CLI may
        # be respawned, and Claude and Codex share one address). Use it rather
        # than failing the launch.
        os.execv(native, [native, *args])

    threading.Thread(target=server.serve_forever, daemon=True).start()

    env = dict(os.environ)
    if tool == "claude":
        # Codex is pointed at the gateway by skuld's own transport, which reads
        # the same env var; only Claude needs redirecting here.
        for key in ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"):
            env.pop(key, None)
        env["ANTHROPIC_BASE_URL"] = f"http://{listen[0]}:{listen[1]}"
        env["ANTHROPIC_AUTH_TOKEN"] = "workload-identity-proxy"
        model = _session_model()
        if model:
            for key in (
                "ANTHROPIC_MODEL",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL",
                "ANTHROPIC_DEFAULT_SONNET_MODEL",
                "ANTHROPIC_DEFAULT_OPUS_MODEL",
                "CLAUDE_CODE_SUBAGENT_MODEL",
            ):
                env[key] = model

    try:
        return subprocess.call([native, *args], env=env)
    finally:
        server.shutdown()
        server.server_close()
        client.close()


if __name__ == "__main__":
    sys.exit(main())
