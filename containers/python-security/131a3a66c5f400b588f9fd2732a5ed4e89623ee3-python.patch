Adapted from 131a3a66c5f400b588f9fd2732a5ed4e89623ee3 (gh-160898) for the
pure-Python module-replacement mechanism of containers/python-security.

Upstream rejects null bytes in socket.getaddrinfo() host and port inside
Modules/socketmodule.c. The interpreter's compiled _socket module cannot be
replaced on every image (it is statically linked into the uv-managed OpenShell
interpreter, and a compiled module would change the build platform and the
interpreter binary). This patch therefore applies the same check, with the same
ValueError messages, in Lib/socket.py before the arguments reach _socket.

The Modules/socketmodule.c section is dropped. The Doc, Lib/test and
Misc/NEWS.d sections are copied verbatim from the upstream patch; build.py
fails unless they match it byte for byte.

diff --git a/Lib/socket.py b/Lib/socket.py
index 9ac0bad..03353af 100644
--- a/Lib/socket.py
+++ b/Lib/socket.py
@@ -969,6 +969,16 @@ def create_server(address, *, family=AF_INET, backlog=None, reuse_port=False,
         raise
 
 
+def _contains_null(value):
+    # The unbound methods read the real data, so a str or bytes subclass that
+    # overrides __contains__ cannot hide a null byte from the check.
+    if isinstance(value, str):
+        return str.__contains__(value, '\0')
+    if isinstance(value, bytes):
+        return bytes.__contains__(value, b'\0')
+    return False
+
+
 def getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
     """Resolve host and port into list of address info entries.
 
@@ -985,6 +995,14 @@ def getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
     """
     # We override this function since we want to translate the numeric family
     # and socket type values to enum constants.
+    #
+    # gh-160898 (CVE-2026-116566): _socket.getaddrinfo() truncates the host and
+    # port at an embedded null byte. Upstream rejects them in C; this guard
+    # raises the same ValueError before the arguments reach the C layer.
+    if _contains_null(host):
+        raise ValueError("getaddrinfo() host must not contain null characters")
+    if _contains_null(port):
+        raise ValueError("getaddrinfo() port must not contain null characters")
     addrlist = []
     for res in _socket.getaddrinfo(host, port, family, type, proto, flags):
         af, socktype, proto, canonname, sa = res
