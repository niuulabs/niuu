  "mitigations": [
    {
      "cve": "CVE-2026-116566",
      "file": "socket.py",
      "justification": "inline_mitigations_already_exist",
      "impact_statement": "socket.getaddrinfo() rejects null bytes in host and port with the ValueError messages of the upstream fix (gh-160898), so every standard-library caller (asyncio, socket.create_connection, urllib, http.client) is protected. The compiled _socket module is not rebuilt: a direct call to the private _socket.getaddrinfo() still truncates at a null byte. The Niuu source tree makes no such call; installed third-party packages were not audited for one."
    }
