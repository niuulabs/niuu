{
  "theme": "ice",
  "plugins": {
    "login": { "enabled": true, "order": 0 },
    "credentials": { "enabled": true, "order": 1 },
    "integrations": { "enabled": true, "order": 2 },
    "volundr": { "enabled": true, "order": 3 },
    "ting": { "enabled": true, "order": 4 },
    "mimir": { "enabled": true, "order": 5 },
    "ravn": { "enabled": true, "order": 6 },
    "observatory": { "enabled": true, "order": 7 },
    "bifrost": { "enabled": true, "order": 8 },
    "settings": { "enabled": true, "order": 9 }
  },
  "services": {
    "identity": { "mode": "http", "baseUrl": "/api/v1" },
    "credentials": { "mode": "http", "baseUrl": "/api/v1/credentials" },
    "integrations": { "mode": "http", "baseUrl": "/api/v1/integrations" },
    "features": { "mode": "http", "baseUrl": "/api/v1" },
    "tracker": { "mode": "http", "baseUrl": "/api/v1" },
    "audit": { "mode": "http", "baseUrl": "/api/v1" },
    "bifrost": { "mode": "http", "baseUrl": "/api/v1/bifrost" },
    "mimir": { "mode": "http", "baseUrl": "/api/v1/mimir" },
    "observatory": { "mode": "http", "baseUrl": "/api/v1/observatory" },
    "observatory.registry": {
      "mode": "http",
      "baseUrl": "/api/v1/observatory/registry"
    },
    "observatory.topology": {
      "mode": "http",
      "baseUrl": "/api/v1/observatory/topology"
    },
    "observatory.events": {
      "mode": "http",
      "baseUrl": "/api/v1/observatory/events"
    },
    "ravn": { "mode": "http", "baseUrl": "/api/v1/ravn" },
    "ravn.personas": { "mode": "http", "baseUrl": "/api/v1/ravn/personas" },
    "ravn.ravens": { "mode": "http", "baseUrl": "/api/v1/ravn/ravens" },
    "ravn.sessions": { "mode": "http", "baseUrl": "/api/v1/ravn/sessions" },
    "ravn.triggers": { "mode": "http", "baseUrl": "/api/v1/ravn/triggers" },
    "ravn.budget": { "mode": "http", "baseUrl": "/api/v1/ravn/budget" },
    "forge": { "mode": "http", "baseUrl": "/api/v1/forge" },
    "forge.pty": { "mode": "ws", "wsUrl": "/s/{sessionId}/session" },
    "forge.metrics": { "mode": "http", "baseUrl": "/api/v1/forge/metrics" },
    "ting": { "mode": "http", "baseUrl": "/api/v1/ting" },
    "ting.dispatcher": {
      "mode": "http",
      "baseUrl": "/api/v1/ting/dispatcher"
    },
    "ting.sessions": { "mode": "http", "baseUrl": "/api/v1/ting/sessions" },
    "ting.dispatch": { "mode": "http", "baseUrl": "/api/v1/ting/dispatch" },
    "ting.settings": { "mode": "http", "baseUrl": "/api/v1/ting/settings" },
    "ting.tracker": { "mode": "http", "baseUrl": "/api/v1/tracker" },
    "ting.audit": { "mode": "http", "baseUrl": "/api/v1/audit" },
    "ting.workflows": { "mode": "http", "baseUrl": "/api/v1/ting/workflows" },
    "filesystem": { "mode": "http", "baseUrl": "/" }
  }
}
