{
  "name": "@niuulabs/plugin-bifrost",
  "version": "0.0.1",
  "description": "Bifrost plugin — model catalog, provider health, and usage control plane",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
