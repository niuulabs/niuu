    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "dompurify": "^3",
    "katex": "^0.16",
    "lucide-react": "^1.43.0",
    "mermaid": "^11",
    "react-markdown": "^10",
    "rehype-katex": "^7",
    "remark-breaks": "^4",
    "remark-gfm": "^4",
    "remark-math": "^6",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@niuulabs/design-tokens": "workspace:*",
