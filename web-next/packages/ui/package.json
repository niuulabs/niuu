{
  "name": "@niuulabs/ui",
  "version": "0.0.1",
  "description": "Shared UI primitives and composites for Niuu plugins",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "dependencies": {
    "@niuulabs/domain": "workspace:*",
    "@niuulabs/query": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-toast": "^1.2.20",
    "@radix-ui/react-tooltip": "^1.2.13",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@niuulabs/design-tokens": "workspace:*",
    "@types/react": "^19.2.17",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.20",
    "postcss-import": "^16.1.0",
    "react": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  }
}
