{
  "name": "@niuulabs/shell",
  "version": "0.0.1",
  "description": "Plugin shell — rail, topbar, subnav, content, footer. Host-agnostic.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@niuulabs/plugin-sdk": "workspace:*",
    "@niuulabs/ui": "workspace:*",
    "clsx": "^2.1.1",
    "@niuulabs/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "postcss-import": "^17.0.1",
    "react": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "react-dom": "^19.3.1",
    "@types/react-dom": "^19.3.0"
  }
}
