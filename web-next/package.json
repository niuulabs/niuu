{
  "name": "niuu-web",
  "private": true,
  "version": "0.0.0",
  "description": "Niuu web — composable plugin-based UI for the Niuu platform",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.6",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "ws@8": "8.21.0",
      "uuid": "14.0.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @niuulabs/niuu dev",
    "dev:playwright": "pnpm -r --filter='./packages/*' build && pnpm --filter @niuulabs/niuu dev",
    "build": "pnpm -r --filter='./packages/*' build && pnpm --filter @niuulabs/niuu build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual/ --reporter=html",
    "test:visual:update": "playwright test e2e/visual/ --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,css,md,json,yaml,yml}\"",
    "typecheck": "pnpm -r typecheck",
    "bootstrap": "bash scripts/bootstrap.sh",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo && rm -rf node_modules"
  },
  "dependencies": {
    "@niuulabs/design-tokens": "workspace:*",
    "@niuulabs/plugin-bifrost": "workspace:*",
    "@niuulabs/plugin-hello": "workspace:*",
    "@niuulabs/plugin-login": "workspace:*",
    "@niuulabs/plugin-mimir": "workspace:*",
    "@niuulabs/plugin-observatory": "workspace:*",
    "@niuulabs/plugin-ravn": "workspace:*",
    "@niuulabs/plugin-ting": "workspace:*",
    "@niuulabs/plugin-valkyrie": "workspace:*",
    "@niuulabs/plugin-volundr": "workspace:*",
    "@niuulabs/shell": "workspace:*",
    "@niuulabs/ui": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.31.0",
    "postcss": "^8",
    "postcss-cli": "^11",
    "postcss-import": "^17",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
