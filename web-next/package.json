{
  "name": "niuu-web",
  "private": true,
  "version": "0.0.0",
  "description": "Niuu web — composable plugin-based UI for the Niuu platform",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.6",
      "ws@8": "8.20.1",
      "uuid": "14.0.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @niuulabs/niuu dev",
    "build": "pnpm -r --filter='./packages/*' build && pnpm --filter @niuulabs/niuu build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual/ --reporter=html",
    "test:visual:update": "playwright test e2e/visual/ --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,css,md,json,yaml,yml}\"",
    "typecheck": "pnpm -r typecheck",
    "bootstrap": "bash scripts/bootstrap.sh",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo && rm -rf node_modules"
  },
  "dependencies": {
    "@niuulabs/design-tokens": "workspace:*",
    "@niuulabs/plugin-bifrost": "workspace:*",
    "@niuulabs/plugin-hello": "workspace:*",
    "@niuulabs/plugin-login": "workspace:*",
    "@niuulabs/plugin-mimir": "workspace:*",
    "@niuulabs/plugin-observatory": "workspace:*",
    "@niuulabs/plugin-ravn": "workspace:*",
    "@niuulabs/plugin-ting": "workspace:*",
    "@niuulabs/plugin-volundr": "workspace:*",
    "@niuulabs/shell": "workspace:*",
    "@niuulabs/ui": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/react": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.17.0",
    "postcss": "^8",
    "postcss-cli": "^11",
    "postcss-import": "^16",
    "prettier": "^3.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
