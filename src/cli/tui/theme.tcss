/* Niuu TUI — Zinc dark theme.
 *
 * Exact color parity with the Go Bubble Tea TUI and the web UI.
 * All widgets reference these variables — never hardcode colors.
 */

/* ── Backgrounds ─────────────────────────────────────────────── */
$bg-primary: #071019;
$bg-secondary: #10212d;
$bg-tertiary: #182b38;
$bg-elevated: #2b4351;

/* ── Text ────────────────────────────────────────────────────── */
$text-primary: #edf4f7;
$text-secondary: #a5b7c1;
$text-muted: #78909d;

/* ── Borders ─────────────────────────────────────────────────── */
$border: #2b4351;
$border-subtle: #182b38;

/* ── Accents ─────────────────────────────────────────────────── */
$accent-amber: #e4bd7e;
$accent-cyan: #86d0e8;
$accent-emerald: #76bfa7;
$accent-purple: #a855f7;
$accent-red: #e78d94;
$accent-indigo: #6366f1;
$accent-orange: #f97316;

/* ── Global Screen ───────────────────────────────────────────── */
Screen {
    background: $bg-primary;
    color: $text-primary;
}
