#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="${ROOT_DIR}/build/dev-run"
LOG_DIR="${RUN_DIR}/logs"
PLATFORM_PID_FILE="${RUN_DIR}/platform.pid"
PG_CTL="${ROOT_DIR}/build/pginstall/bin/pg_ctl"
PG_DATA="${HOME}/.niuu/pgdata"
PLATFORM_LOG="${LOG_DIR}/platform.log"
UI_VARIANT="${NIUU_WEB_UI:-old}"

# Auto-detect a LAN-routable IP so the platform binds to (and bakes into URLs)
# an address that browsers on this machine *and* on the LAN can reach. Override
# by exporting NIUU_SERVER__HOST before invoking this script.
detect_lan_ip() {
  python3 - <<'PY' 2>/dev/null
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.connect(("8.8.8.8", 80))
    print(s.getsockname()[0])
finally:
    s.close()
PY
}

if [[ -z "${NIUU_SERVER__HOST:-}" ]]; then
  detected_ip="$(detect_lan_ip || true)"
  NIUU_SERVER__HOST="${detected_ip:-127.0.0.1}"
fi
export NIUU_SERVER__HOST
PLATFORM_URL="http://${NIUU_SERVER__HOST}:8080/health"

mkdir -p "${LOG_DIR}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--ui old|new]

Environment:
  NIUU_WEB_UI=old|new   Select which web UI bundle to build and serve.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ui)
      if [[ $# -lt 2 ]]; then
        echo "--ui requires a value of 'old' or 'new'" >&2
        usage >&2
        exit 1
      fi
      UI_VARIANT="$2"
      shift 2
      ;;
    --ui=*)
      UI_VARIANT="${1#--ui=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

case "${UI_VARIANT}" in
  old|new)
    ;;
  *)
    echo "Invalid UI selection: ${UI_VARIANT}. Expected 'old' or 'new'." >&2
    exit 1
    ;;
esac

cleanup_on_error() {
  "${ROOT_DIR}/stop-dev" >/dev/null 2>&1 || true
}

require_system_tool() {
  local tool="$1"
  if command -v "${tool}" >/dev/null 2>&1; then
    return 0
  fi
  echo "Required system tool '${tool}' not found on PATH." >&2
  echo "Install it via your OS package manager (apt/dnf/brew) and re-run start-dev." >&2
  return 1
}

ensure_uv() {
  # Standard install location — add to PATH first so an existing install is detected.
  export PATH="${HOME}/.local/bin:${PATH}"
  if command -v uv >/dev/null 2>&1; then
    return 0
  fi
  echo "Installing uv..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
  if ! command -v uv >/dev/null 2>&1; then
    echo "uv install completed but 'uv' is not on PATH (expected ${HOME}/.local/bin/uv)." >&2
    return 1
  fi
}

ensure_pnpm() {
  # Standard install location — add to PATH first so an existing install is detected.
  export PNPM_HOME="${PNPM_HOME:-${HOME}/.local/share/pnpm}"
  export PATH="${PNPM_HOME}:${PATH}"
  if command -v pnpm >/dev/null 2>&1; then
    return 0
  fi
  echo "Installing pnpm..."
  curl -fsSL https://get.pnpm.io/install.sh | env SHELL="${SHELL:-/bin/bash}" sh -
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "pnpm install completed but 'pnpm' is not on PATH (expected ${PNPM_HOME}/pnpm)." >&2
    return 1
  fi
}

ensure_node() {
  if command -v node >/dev/null 2>&1; then
    return 0
  fi
  echo "Installing Node.js (LTS) via pnpm..."
  pnpm env use --global lts
  if ! command -v node >/dev/null 2>&1; then
    echo "Node install completed but 'node' is not on PATH." >&2
    return 1
  fi
}

bootstrap_dependencies() {
  echo "Checking dependencies..."
  require_system_tool curl
  require_system_tool make
  require_system_tool gcc
  require_system_tool pkg-config
  ensure_uv
  ensure_pnpm
  ensure_node
}

wait_for_url() {
  local url="$1"
  local label="$2"
  local attempts="${3:-60}"

  for ((i = 1; i <= attempts; i++)); do
    if curl -fsS "${url}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done

  echo "${label} failed to become ready. Check logs:" >&2
  echo "  ${PLATFORM_LOG}" >&2
  return 1
}

wait_for_platform() {
  local pid="$1"
  local url="$2"
  local attempts="${3:-60}"

  for ((i = 1; i <= attempts; i++)); do
    if ! kill -0 "${pid}" >/dev/null 2>&1; then
      echo "Platform process exited before becoming ready. Check logs:" >&2
      echo "  ${PLATFORM_LOG}" >&2
      return 1
    fi

    if curl -fsS "${url}" >/dev/null 2>&1; then
      if kill -0 "${pid}" >/dev/null 2>&1; then
        return 0
      fi

      echo "Platform probe succeeded, but the launched process exited. Check logs:" >&2
      echo "  ${PLATFORM_LOG}" >&2
      return 1
    fi

    sleep 1
  done

  echo "Platform failed to become ready. Check logs:" >&2
  echo "  ${PLATFORM_LOG}" >&2
  return 1
}

trap cleanup_on_error ERR

bootstrap_dependencies

"${ROOT_DIR}/stop-dev" >/dev/null 2>&1 || true

echo "Preparing workspace..."
uv sync --extra dev
make -C "${ROOT_DIR}" build-postgres
if [[ "${UI_VARIANT}" == "new" ]]; then
  pnpm --dir "${ROOT_DIR}/web-next" install
  pnpm --dir "${ROOT_DIR}/web-next" -r --filter "@niuulabs/*" --filter "!@niuulabs/niuu" build
  (
    cd "${ROOT_DIR}/web-next/apps/niuu"
    pnpm exec vite build
  )
else
  make -C "${ROOT_DIR}" build-web
fi

if [[ -x "${PG_CTL}" ]]; then
  "${PG_CTL}" -D "${PG_DATA}" stop -m fast >/dev/null 2>&1 || true
fi

# Old UI uses the legacy /api/v1/volundr/* routes (e.g. /api/v1/volundr/models),
# which only get mounted under the full-compat host profile. New UI uses the
# split canonical routes that ship in the default 'full' profile.
if [[ "${UI_VARIANT}" == "old" ]]; then
  HOST_PROFILE="full-compat"
else
  HOST_PROFILE="full"
fi

echo "Starting platform on ${NIUU_SERVER__HOST}:8080 (host-profile=${HOST_PROFILE})..."
nohup env PYTHONUNBUFFERED=1 \
  NIUU_WEB_UI="${UI_VARIANT}" \
  uv run niuu platform up --skip-preflight --host-profile "${HOST_PROFILE}" \
  >"${PLATFORM_LOG}" 2>&1 &
echo $! > "${PLATFORM_PID_FILE}"
wait_for_platform "$(cat "${PLATFORM_PID_FILE}")" "${PLATFORM_URL}"

trap - ERR

cat <<EOF
Ready.

UI:
  variant: ${UI_VARIANT}
  http://${NIUU_SERVER__HOST}:8080/?config=/config.live.json
  http://${NIUU_SERVER__HOST}:8080/volundr?config=/config.live.json

API:
  http://${NIUU_SERVER__HOST}:8080/health

Logs:
  ${PLATFORM_LOG}

Stop:
  ${ROOT_DIR}/stop-dev
EOF
